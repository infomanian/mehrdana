# Public keys are safe to ship to the browser. Never add the service role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used by trusted server code only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the site (used for metadata and canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (server-only secret + webhook signing secret). International USD checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (server-only). International USD checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live"
PAYPAL_MODE=sandbox
